# ============================================================
# Workora - BACKEND environment (used by apps/api, apps/mcp, packages/core)
# Copy to `.env` in the repository root and fill in the blanks.
# ============================================================

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://workora:workora@localhost:5432/workora?schema=public

# --- API server ---
API_PORT=4000
# Origin of the Next.js app (used for CORS)
WEB_ORIGIN=http://localhost:3000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
NODE_ENV=development

# --- Seed admin (used by `npm run db:seed`) ---
SEED_ADMIN_EMAIL=superadminasim@admin.com
SEED_ADMIN_NAME=Super Admin
# Choose a strong password (min 8 chars) BEFORE seeding, then change it in Settings
SEED_ADMIN_PASSWORD=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Jira (leave JIRA_API_TOKEN empty to run in mock mode) ---
JIRA_SITE_URL=https://alisquare.atlassian.net/jira
JIRA_EMAIL=asim.ghaffar71@gmail.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AL

# --- Slack (leave SLACK_BOT_TOKEN empty to run in mock mode) ---
# Bot scopes: chat:write, users:read.email (channels:read only if needed elsewhere)
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL_ID=C06J1ARK97V

# --- GitHub (leave GITHUB_TOKEN empty to run in mock mode) ---
# Fine-grained token with read access to Contents, Pull requests, Metadata
GITHUB_TOKEN=
GITHUB_REPOS=Mr-AsimGhaffar/AI-Product-Studio,Mr-AsimGhaffar/alisquare-website

# --- MCP server (used when external clients like VS Code run apps/mcp over stdio) ---
# Role used for docs_search results: ADMIN | MANAGER | EMPLOYEE
MCP_DOCS_ROLE=EMPLOYEE
