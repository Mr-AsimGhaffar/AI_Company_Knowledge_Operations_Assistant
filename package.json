{
  "name": "workora",
  "private": true,
  "version": "0.1.0",
  "description": "Workora - Company Knowledge & Operations Assistant (RAG + MCP)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "dotenv -e .env -- prisma generate --schema packages/core/prisma/schema.prisma",
    "db:push": "dotenv -e .env -- prisma db push --schema packages/core/prisma/schema.prisma",
    "db:seed": "npm run seed -w @workora/api",
    "dev": "concurrently -n api,web -c yellow,magenta \"npm run dev -w @workora/api\" \"npm run dev -w @workora/web\"",
    "dev:api": "npm run dev -w @workora/api",
    "dev:web": "npm run dev -w @workora/web",
    "dev:mcp": "npm run dev -w @workora/mcp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
